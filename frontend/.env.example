# Backend API base URL (nginx proxies /api/ to the Fastify process in prod)
NEXT_PUBLIC_API_URL=http://localhost:3105

# --- PostHog (optional; unset = analytics fully off, site behaves normally) ---
# Project token from PostHog > Settings > Project. Write-only, safe in the
# client bundle. MUST come from the same region as NEXT_PUBLIC_POSTHOG_HOST.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Ingestion host. Defaults to US when unset — the live project (531983) is on
# US Cloud. A region mismatch silently drops every event rather than erroring.
#   US: https://us.i.posthog.com    EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Same-origin proxy path, served by nginx (see docs/posthog.md).
# Set to /ingest in PRODUCTION ONLY. Leave blank locally — there is no nginx
# in dev, so a value here would send events into the Next router and 404.
NEXT_PUBLIC_POSTHOG_PROXY=
