generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// Parent product line (e.g. "Retatrutide") — owns the one storefront URL and
// everything shared across sizes. Sellable SKUs live on ProductVariant below.
model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  categoryId    String
  description   String?
  benefits      String?
  dosageInfo    String?
  coaUrl        String?
  featured      Boolean  @default(false)
  // Manual curation order among featured products (lower = shown first).
  // Ties (the common case — everything starts at 0) fall back to
  // createdAt desc, so this is inert until an admin actually reorders.
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  // True for supply items that should only ever be sold bundled as another
  // product's add-on (e.g. a free syringe/alcohol swab included with a
  // peptide) — never independently browsable/purchasable on their own
  // storefront page. Deliberately separate from `active`: `active` still
  // gates whether this is allowed to appear as an add-on at all (see
  // products.controller.ts), so setting active:false to hide it from the
  // catalog would also silently break it as an add-on everywhere it's used.
  addOnOnly     Boolean  @default(false)
  // Plain-text nudge shown near Add to Cart on the storefront (e.g. "This
  // peptide needs Bacteriostatic Water to reconstitute") — informational
  // only, distinct from the required/forced ProductAddOn mechanism below.
  addOnReminder String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  // Add-ons this product line offers on its page (e.g. BAC Water for a
  // lyophilized peptide), regardless of which variant/size is purchased.
  // Points down to the specific sellable ProductVariant being offered.
  addOns   ProductAddOn[]
  // Gallery shots that belong to the product line rather than to any one
  // size: packaging, the vial in use, a reconstitution step. Variant images
  // stay on ProductVariant because those DO change with the selected size;
  // these are the ones that don't.
  images   ProductImage[]

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

// A product-level gallery image. Deliberately its own table rather than a
// JSON column on Product: ordering is a first-class concern for a carousel,
// and rows are cheap to reorder and delete individually.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  // Lower shows first. The storefront gallery lists variant images first
  // (they're what the size picker jumps to), then these by sortOrder.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// A single sellable SKU (one size/strength) belonging to a parent Product.
// This table held the flat one-row-per-size product data before the
// parent/variant rework — ids were preserved as-is (see the migration
// script), so every OrderItem/ProductAddOn.addOnId reference kept working
// unchanged across the rework.
model ProductVariant {
  id           String    @id @default(cuid())
  productId    String
  code         String    @unique
  size         String?
  price        Int
  // Genuine time-limited sale — null salePrice means "not on sale". A sale is
  // only considered active when salePrice is set AND the current time falls
  // within [saleStartsAt, saleEndsAt]. See backend/src/utils/product-pricing.ts
  // (and its frontend counterpart) for the single source of truth on this
  // logic — order creation, storefront display, and JSON-LD must all agree.
  salePrice    Int?
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  stock        Int       @default(0)
  imageUrl     String?
  // Lets one size be discontinued without touching the parent or its other
  // sizes — a variant can never be hard-deleted once an order references it
  // (OrderItem's FK below has no cascade), so this is the only way to retire one.
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product           Product        @relation(fields: [productId], references: [id])
  orderItems        OrderItem[]
  offeredAsAddOnFor ProductAddOn[]

  @@index([productId])
  @@index([active])
  @@map("product_variants")
}

// Explicit join model for a Product-to-ProductVariant add-on relation.
// productId = the parent product line whose page shows the add-on (applies
// regardless of which of its own variants is purchased); addOnId = the
// specific sellable variant being offered (e.g. a particular Bac Water size).
model ProductAddOn {
  id        String  @id @default(cuid())
  productId String
  addOnId   String
  // Force-selected and locked on the storefront product page — the customer
  // cannot uncheck it. Enforced again server-side at order-creation time
  // (see createOrder) so a bypassed/omitted client request still can't ship
  // a reconstitution-requiring peptide without its required supplies.
  required  Boolean @default(false)
  // Fixed quantity added when this add-on is included — intentionally does
  // NOT scale with the parent product's purchased quantity.
  quantity  Int     @default(1)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  addOn   ProductVariant @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([productId, addOnId])
  @@map("product_add_ons")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  WHATSAPP
  BILLPLZ
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  customerName   String
  phone          String
  email          String?
  address        String
  city           String
  state          String
  postcode       String
  subtotal       Int           @default(0)
  shippingFee    Int           @default(0)
  discountAmount Int           @default(0)
  total          Int
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod
  paymentGateway String?
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentRef     String?
  discountCodeId String?
  notes          String?
  trackingNumber String?
  idempotencyKey String?       @unique
  stockRestored  Boolean       @default(false)
  // Operational tick-box: the profit for this order has actually been paid out
  // to the people in its split. Deliberately manual and separate from whether a
  // split has been RECORDED (order_profit_shares rows) or whether the order is
  // fully costed — money leaving the account is a real-world event the system
  // cannot observe, so someone has to assert it.
  profitShared   Boolean       @default(false)
  // Soft-delete only — admin "Delete" never removes the row, it just moves
  // the order into a separate Deleted view (set) / back out of it (null).
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items        OrderItem[]
  delivery     DeliveryBooking?
  discountCode DiscountCode?      @relation(fields: [discountCodeId], references: [id])
  emails       EmailOutbox[]
  profitShares OrderProfitShare[]
  extraCosts   OrderExtraCost[]
  reminders    AgentReminder[]

  @@index([phone])
  @@index([status])
  @@index([orderNumber])
  @@index([paymentRef])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  // Prisma-level rename only (was `productId`) — the physical column is
  // untouched via @map, so existing rows need no data migration at all.
  variantId String   @map("productId")
  quantity  Int
  unitPrice Int
  // What this line actually cost us, per unit, in cents — entered by an admin
  // on the order detail page's Profit Sharing tab. Line cost is unitCost ×
  // quantity. Nullable rather than defaulted to 0 so "nobody has priced this
  // line yet" stays distinguishable from "this line genuinely cost nothing";
  // the tab reports profit as unknown until every line has a cost.
  //
  // Lives here rather than on ProductVariant on purpose: this is the cost of
  // *this* purchase, and it must not move when a supplier price changes later.
  // A default cost per variant is a reasonable thing to add above this one day,
  // but it would be a prefill for this field, never a replacement.
  unitCost  Int?
  createdAt DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// Costs attached to an order that aren't the goods themselves — fuel, the
// courier charge, packaging, a one-off fee. Free-form label + amount rather
// than a fixed enum of categories, because the useful categories aren't known
// yet and an enum would need a migration every time a new kind of cost shows up.
model OrderExtraCost {
  id      String @id @default(cuid())
  orderId String
  label   String
  // Cents, same as every other money field in this schema.
  amount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_extra_costs")
}

// How one order's profit is split between the people behind Ascend MY. Stored per
// order rather than as one global rule because the split genuinely can differ
// order to order (a partner who sourced a particular batch, a one-off referral
// cut), and because backfilling a changed global rule onto historical orders
// would silently rewrite what people were already told they earned.
//
// Since the finance section landed, a share also points at a real Partner
// (see below), which is what makes lifetime per-person totals possible. Still
// absent: per-item rather than per-order splits.
model OrderProfitShare {
  id            String  @id @default(cuid())
  orderId       String
  // The person this share belongs to. Nullable only so the column could be
  // added to existing rows before the backfill ran — every row written since
  // has one, and the API resolves/creates a Partner from `name` on save.
  partnerId     String?
  // The display label as it was typed on the order. Kept alongside partnerId
  // as a frozen historical record: renaming a Partner must not silently rewrite
  // what an old order says it agreed to.
  name          String
  // Basis points, not whole percent — 5000 = 50%. An even three-way split is
  // the immediate reason (3333/3333/3334), and it matches the codebase's
  // existing "money and rates are integers, never floats" convention.
  //
  // This governs PROFIT only. Capital is not a percentage — see below.
  shareBps      Int
  // How much of this order's COSTS this person paid for, in cents.
  //
  // An order's costs have to come out of somebody's pocket before the customer
  // pays. This records whose. It is money OWED BACK to them, so it is ADDED to
  // their cut, not taken off it: on a RM145 order costing RM60, whoever put up
  // that RM60 gets it back plus their share of the RM85 profit.
  //
  // Deliberately not a percentage and not derived: who fronts an order is a
  // fact about that order, not a formula. The sum across a split is expected to
  // equal the order's total cost, but is not enforced — the company float can
  // cover part of it, and a hard gate here would block real orders.
  //
  // Do NOT also record the same money as an ADVANCE in PartnerFunding. That
  // would pay it back twice.
  capitalAmount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner Partner? @relation(fields: [partnerId], references: [id])

  @@index([orderId])
  @@index([partnerId])
  @@map("order_profit_shares")
}

enum EmailType {
  ORDER_CONFIRMATION
  PAYMENT_RECEIPT
  // Sent once to a gateway order that was created but never paid, while its
  // bill is still open. Rides the same outbox as the two above precisely
  // because the (orderId, type) unique key is what makes "once" true — the
  // sweep that enqueues it runs every 10 minutes and would otherwise nag.
  ABANDONED_CHECKOUT
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  // Set from the Resend webhook (modules/webhooks/resend-webhook.controller.ts)
  // once a SENT row's message reaches one of these terminal delivery states.
  DELIVERED
  BOUNCED
  COMPLAINED
}

// Transactional-email outbox: state changes (order created, payment
// confirmed) insert a row here inside the SAME transaction as the state
// change, and a background worker (utils/email-worker.ts) drains it via
// Resend. Emails are never sent inline — a gateway outage can't fail a
// checkout, and a crashed send is retried instead of lost.
model EmailOutbox {
  id            String      @id @default(cuid())
  orderId       String
  type          EmailType
  toEmail       String
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  resendId      String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // At most one email of each type per order — payment callbacks can fire
  // twice, so enqueue uses skipDuplicates against this instead of erroring.
  @@unique([orderId, type])
  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model DiscountCode {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Int
  minOrderAmount Int?
  maxUses        Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]
  // Set only on the single-use codes minted for newsletter welcome emails, so
  // an admin deleting a subscriber can't orphan a code that a real order may
  // already reference (the relation is optional in both directions).
  subscriber Subscriber?

  @@map("discount_codes")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

// Admin-managed article ("Insights" section) — research commentary and
// product-update writeups, credited to a named author for E-E-A-T. Kept as
// its own flat model rather than reusing Product: no variants/pricing/stock,
// and its lifecycle (draft -> published) doesn't map to Product.active.
model Insight {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  category          String
  excerpt           String
  content           String
  coverImageUrl     String?
  authorName        String    @default("Asywa")
  authorRole        String    @default("Founder & CEO, Ascend MY")
  citationTitle     String?
  citationSource    String?
  citationUrl       String?
  // Estimated server-side from `content` on every save (~200 words/minute) —
  // never client-supplied, so it can't drift from the actual body length.
  readTimeMinutes   Int       @default(1)
  // Product (parent) ids surfaced as "Mentioned in this article" chips.
  // A plain id array rather than a join table: no per-relation attributes
  // (unlike ProductAddOn's required/quantity), so a join model would be
  // pure overhead here.
  relatedProductIds String[]  @default([])
  published         Boolean   @default(false)
  // Set once, the first time `published` flips true — a later edit-and-resave
  // must not look like a brand new publish date.
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  figures  InsightFigure[]
  comments InsightComment[]

  @@index([published])
  @@index([category])
  @@map("insights")
}

// A labelled figure belonging to an article — image, caption, attribution —
// rendered as a numbered grid below the body, the way a journal paper presents
// them. The prose refers to them by number ("see Figure 2").
//
// A real table rather than a string array (contrast `relatedProductIds` above,
// which is deliberately a bare id list): every column here is a per-row
// attribute, which is exactly the case that note says a join model is *not*
// overhead for.
model InsightFigure {
  id        String  @id @default(cuid())
  insightId String
  // 1-based, and it IS the label the reader sees ("Figure 3") — not a hidden
  // sort key. Renumbered on save whenever figures are reordered.
  order     Int
  imageUrl  String
  caption   String
  // Describes what the diagram actually shows, for screen readers. Distinct
  // from the caption, which is the printed label. Defaulted rather than
  // required at the DB level so this column can be added without a backfill;
  // the admin form is what insists on it.
  altText   String  @default("")
  // Attribution, e.g. "Adapted from Doe et al., Biomolecules 2025 (CC BY 4.0)".
  // Journal figures are usually copyrighted — see docs/insights-figures-plan.md.
  credit    String?
  creditUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  // A figure has no meaning without its article, hence the cascade above; the
  // unique pair keeps two figures from claiming the same printed number.
  @@unique([insightId, order])
  @@index([insightId])
  @@map("insight_figures")
}

// ---------------------------------------------------------------- Members
//
// Storefront accounts, kept deliberately separate from AdminUser above. The
// two are different populations with different trust levels, and collapsing
// them into one table with a role column would mean one bad query away from a
// commenter holding admin rights. The JWTs are separated too — see the `kind`
// claim in plugins/auth.ts.
//
// Today an account does exactly one thing: it lets you comment on an Insight.
// Orders remain guest checkout and are NOT linked here.
model Member {
  id           String  @id @default(cuid())
  // Stored lowercased (normalised at the controller) so "A@x.com" and
  // "a@x.com" can't become two accounts that look identical in the UI.
  email        String  @unique
  passwordHash String
  // What other readers see on a comment. Email is never exposed publicly.
  displayName  String

  // Unverified accounts can sign in but cannot post — see authenticateMember.
  // That ordering is deliberate: a signed-in-but-unverified user gets a "check
  // your inbox" prompt in place of the composer, rather than a login form that
  // appears to have silently failed.
  emailVerified Boolean @default(false)
  // Only the SHA-256 of the emailed token is stored. A leaked DB snapshot then
  // can't be replayed to verify (and thereby take over) a pending address —
  // same reasoning as not storing raw passwords.
  verifyTokenHash      String?
  verifyTokenExpiresAt DateTime?

  // Moderation of last resort. Banned members keep their rows (so their past
  // comments stay attributable) but can neither sign in nor post.
  banned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments InsightComment[]

  @@index([verifyTokenHash])
  @@map("members")
}

// A reader's comment on an article. Flat — no parent/reply threading, no
// votes: this is a comment section, not a forum, and adding either later is a
// migration rather than a rewrite.
model InsightComment {
  id        String @id @default(cuid())
  insightId String
  memberId  String
  body      String

  // Soft moderation. Hidden comments stay in the table (so the admin can
  // review a decision, and so a spammer can't tell whether their post was
  // removed or simply ignored) but are filtered out of every public read.
  hidden Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Covers the public thread read: one article's visible comments, newest
  // first. `hidden` is in the index because every public query filters on it.
  @@index([insightId, hidden, createdAt])
  @@index([memberId])
  @@map("insight_comments")
}

// ---------------------------------------------------------------- Finance
//
// Order-level profit (OrderProfitShare above) answers "how was THIS sale
// divided". The models below answer the lifetime questions: what has each
// person earned in total, what has the company spent on itself, who has put
// money in, and what is each person actually owed right now.
//
// Design notes live in docs/finance-section-plan.md. Two rules matter most:
//
//  1. Company spending reduces company profit, and nothing else. It never lands
//     on a person as a charge. Money a person put IN is recorded in one of two
//     places: per order, as the capital they fronted for that order's costs
//     (OrderProfitShare.capitalAmount), or as standing funding below. Both are
//     owed back; neither is ever a deduction.
//  2. Money a partner puts in is NOT one thing. A CONTRIBUTION is capital they
//     never want back; an ADVANCE is a debt the company must return. Only the
//     second belongs in "owed".

model Partner {
  id     String  @id @default(cuid())
  name   String  @unique
  // Deactivated rather than deleted — a former partner still has history, and
  // inactive partners drop out of the pickers for new records.
  active Boolean @default(true)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profitShares OrderProfitShare[]
  funding      PartnerFunding[]
  payouts      ProfitPayout[]
  expensesPaid CompanyExpense[]   @relation("ExpensePaidBy")

  @@index([active])
  @@map("partners")
}

// Spending on the business itself — ads, software, equipment, stock bought
// ahead of demand. Distinct from OrderExtraCost, which is tied to one order.
model CompanyExpense {
  id          String   @id @default(cuid())
  occurredAt  DateTime
  // Free text by design, with the form suggesting categories already in use.
  category    String
  description String
  amount      Int

  // Who actually fronted the cash. Null means it came from a company account
  // and creates no obligation to anyone. This is the ONLY way an expense
  // touches a person: it never lands on anyone's balance as a cost, only as
  // money the company may owe the person who paid it.
  paidByPartnerId String?
  receiptUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paidBy  Partner?        @relation("ExpensePaidBy", fields: [paidByPartnerId], references: [id])
  // The funding record created when a partner paid for this out of pocket.
  funding PartnerFunding?

  @@index([occurredAt])
  @@index([category])
  @@map("company_expenses")
}

model PartnerFunding {
  id          String      @id @default(cuid())
  partnerId   String
  type        FundingType
  amount      Int
  occurredAt  DateTime
  description String
  // Set when this funding IS a partner paying a company expense, rather than
  // transferring cash in. Unique: one expense can only be funded once.
  expenseId   String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner    Partner            @relation(fields: [partnerId], references: [id])
  expense    CompanyExpense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  repayments PartnerRepayment[]

  @@index([partnerId])
  @@map("partner_funding")
}

enum FundingType {
  // Pure investment. Never repaid, creates no debt, never appears in "owed".
  CONTRIBUTION
  // The company owes this back. Outstanding until repaid, whole or in parts.
  ADVANCE
}

// A repayment against one specific ADVANCE. Its own rows rather than a `repaid`
// boolean because partly repaying an advance is the normal case — outstanding
// is then derived (amount − sum of repayments) and never stored.
model PartnerRepayment {
  id         String   @id @default(cuid())
  fundingId  String
  amount     Int
  occurredAt DateTime
  note       String?

  createdAt DateTime @default(now())

  funding PartnerFunding @relation(fields: [fundingId], references: [id], onDelete: Cascade)

  @@index([fundingId])
  @@map("partner_repayments")
}

// Paying out profit a partner has earned. Kept separate from repaying an
// advance on purpose: one settles a debt, the other distributes earnings, and
// merging them makes "what has this business actually returned to people"
// unanswerable.
model ProfitPayout {
  id         String   @id @default(cuid())
  partnerId  String
  amount     Int
  occurredAt DateTime
  note       String?

  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@map("profit_payouts")
}

// ------------------------------------------------- WhatsApp AI agent
//
// An operator-facing agent: it does admin work on instruction, over WhatsApp.
// It is NOT a customer-facing chatbot, and the models below are what keep it
// that way. Two independent gates decide whether an inbound message is even
// looked at:
//
//   1. WhatsAppOperator — the sender's phone must be listed and active.
//   2. WhatsAppGroup    — in a group, the group must ALSO be listed and active.
//
// Both must pass in a group; only the first applies in a DM. A message from an
// unknown number is dropped silently (no reply at all) rather than refused —
// a refusal confirms the number is live and tells a stranger there is an
// admin bot on the other end.

model WhatsAppOperator {
  id       String  @id @default(cuid())
  // Normalized to digits-only international form (60123456789) by
  // utils/phone.ts before storage AND before every lookup — a number stored
  // as "+60 12-345 6789" would never match an inbound JID and would silently
  // lock the operator out.
  phone    String  @unique
  name     String
  // WhatsApp's privacy identifier for this person, e.g. "67615754068059".
  //
  // Load-bearing, not a nicety. WhatsApp now delivers many direct messages
  // with ONLY a `@lid` sender — no phone number anywhere in the payload
  // (verified on the wire: the whole message key is
  // {remoteJid:"...@lid", fromMe, id}). baileys 6.17.16 exposes no LID→phone
  // mapping and `onWhatsApp()` returns nothing useful, so an operator whose
  // messages arrive as a LID cannot be matched by phone at all.
  //
  // Filled in by an admin explicitly binding an unrecognised sender to this
  // operator. Deliberately never inferred from `pushName`: that is a display
  // name the sender chooses, so matching on it would let anyone claim an
  // operator's identity by renaming themselves.
  lid      String? @unique
  // Revoked rather than deleted, so the tool-call audit trail below keeps
  // resolving to a real name after someone leaves.
  active   Boolean @default(true)
  // False = read-only operator: reports, lookups and summaries run, every
  // mutating tool is refused. Lets a partner query the business without
  // being able to change it.
  canWrite Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("whatsapp_operators")
}

// Someone who messaged the agent and could not be resolved to an operator.
//
// Exists so the LID problem is recoverable from the dashboard rather than from
// the server logs. Without it, an operator whose messages arrive as a `@lid`
// is silently ignored forever with no visible explanation — which is exactly
// how this system first appeared broken.
//
// Recorded for ANY unresolved sender, including genuine strangers, so it also
// doubles as a "who is messaging this number" view. The sender is still
// ignored — nothing here grants access; it only makes the binding possible.
model WhatsAppUnknownSender {
  id           String   @id @default(cuid())
  // The `@lid` identifier, or a phone number for non-LID senders.
  identifier   String   @unique
  isLid        Boolean  @default(false)
  // Whatever display name the sender set. UNTRUSTED — shown to the admin only
  // as a hint when binding, never used to match automatically.
  pushName     String?
  // Kept so an admin can see what they were trying to do before deciding
  // whether this is a colleague or a stranger. Truncated.
  lastMessage  String?
  messageCount Int      @default(1)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([lastSeenAt])
  @@map("whatsapp_unknown_senders")
}

// A group the agent is allowed to work in. Deliberately an allowlist of
// specific groups rather than "any group an admin is in": the connected
// number sits in supplier and customer groups too, and the agent must never
// act on chatter there.
model WhatsAppGroup {
  id             String  @id @default(cuid())
  groupJid       String  @unique
  subject        String
  active         Boolean @default(true)
  // When true (the default), the agent only responds in this group if the
  // message @-mentions it or replies to one of its own messages. Without
  // this a busy ops group turns every passing remark into an LLM call — and,
  // worse, into a tool call.
  requireMention Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("whatsapp_groups")
}

// One running conversation. A group is a single shared conversation (so two
// operators in the same group see one coherent thread), while each DM is its
// own — hence a synthetic `chatKey` rather than a phone number as the identity.
model AgentConversation {
  id      String @id @default(cuid())
  // "dm:60123456789" or "group:120363...@g.us"
  chatKey String @unique
  kind    String
  title   String

  lastMessageAt DateTime @default(now())
  messageCount  Int      @default(0)

  // Rolling compaction of the thread. `summary` is a prose recap of the oldest
  // `summarizedCount` messages, which are then no longer sent to the model; the
  // newest turns are still sent verbatim. See context.ts.
  //
  // `summarizedCount` is a count rather than a timestamp watermark on purpose:
  // the user and assistant rows of one turn are written milliseconds apart and
  // can share a createdAt, so a `createdAt >` filter can silently drop or
  // double-count a message at the boundary. A count paired with a deterministic
  // (createdAt, id) ordering cannot.
  summary         String?
  summarizedCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AgentMessage[]
  pending  AgentPendingAction[]

  @@index([lastMessageAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String  @id @default(cuid())
  conversationId String
  // 'user' | 'assistant'. Tool traffic is NOT stored here — it lives in
  // AgentToolCall below. Replaying raw tool payloads back into the model on
  // every turn would blow the context window on a long-running ops thread,
  // and the tool results are stale by then anyway.
  role           String
  content        String
  // Who actually spoke. Meaningful in groups, where one conversation carries
  // several operators; null on assistant rows.
  senderPhone    String?
  senderName     String?

  createdAt DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

// Every tool invocation, successful or not. This is the accountability record
// for a system that can delete an order or move money: `AgentMessage` says what
// was asked, this says what was actually done, by whom, and whether it worked.
model AgentToolCall {
  id             String  @id @default(cuid())
  conversationId String?
  actorPhone     String
  toolName       String
  // JSON. Truncated on write — a bulk tool's arguments can be large and this
  // table is an audit trail, not a backup.
  input          String
  ok             Boolean
  result         String
  // Whether this tool required an explicit confirmation before running.
  destructive    Boolean @default(false)
  durationMs     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([toolName])
  @@index([actorPhone])
  @@map("agent_tool_calls")
}

// A destructive tool call parked awaiting a yes. Stored rather than held in
// memory so a worker restart mid-confirmation can't resurrect a stale
// "delete everything" the operator has since walked away from — and so the
// pending action survives long enough to actually be answered.
model AgentPendingAction {
  id             String   @id @default(cuid())
  conversationId String
  actorPhone     String
  toolName       String
  input          String
  // Human-readable description of exactly what will happen, echoed back to
  // the operator. This is what they are agreeing to, so it is generated from
  // the resolved arguments, never from the raw request text.
  summary        String
  expiresAt      DateTime

  createdAt DateTime @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([expiresAt])
  @@map("agent_pending_actions")
}

// A "remind me about X at Y" set through the agent.
//
// Scheduled as a ROW plus a sweep (utils/reminder-sweep.ts, fired from the
// interval in server.ts), deliberately not as an OS cron entry per reminder.
// A crontab line cannot be listed or cancelled from the dashboard, does not
// survive a redeploy of a container it lives in, and would need shell access
// from the API process. A row is queryable, cancellable, and recoverable — the
// same shape the transactional email outbox already uses, for the same reasons.
//
// Because it is a row, a reminder is never lost to downtime: one that came due
// while WhatsApp was disconnected is still PENDING when the worker returns and
// goes out late, which is what someone who asked to be reminded actually wants.
model AgentReminder {
  id String @id @default(cuid())

  // What to say when it fires. Stored as the finished sentence rather than a
  // template, so the reminder reads the same however the model later phrases
  // things — and so an operator can see, now, the exact words they will get.
  message String

  // Optional subject the reminder hangs off. Free text ("restock BPC-157")
  // rather than an enum: the request was "a specific order or any specific
  // thing", and most reminders are not about an order at all.
  topic   String?
  orderId String?

  dueAt DateTime

  // WHERE it goes, in the same "dm:<phone>" / "group:<jid>" form as
  // AgentConversation.chatKey, so "send it back to this conversation" is a
  // straight copy of the key rather than a second addressing scheme that can
  // disagree with the first.
  targetChatKey String
  // How that target reads to a human ("this group — Ops", "Fakhrul"). Frozen
  // at creation so the confirmation the operator saw is what gets shown back,
  // even if the group is later renamed.
  targetLabel   String

  status        ReminderStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lastError     String?
  sentAt        DateTime?

  // Who set it and where from — an audit trail, and what "my reminders" filters
  // on when an operator asks what they have pending.
  createdByPhone   String
  createdByName    String
  createdInChatKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // The sweep's only query: due, still pending, ready to retry.
  @@index([status, nextAttemptAt])
  @@index([createdByPhone, status])
  @@index([orderId])
  @@map("agent_reminders")
}

enum ReminderStatus {
  PENDING
  SENT
  // Called off by an operator before it fired.
  CANCELLED
  // Gave up after repeated send failures — kept, never deleted, so a reminder
  // that never reached anyone is visible rather than silently gone.
  FAILED
}

// ------------------------------------------------- Delivery scheduling
//
// Asywa's delivery diary: one booking per order, at whatever time she says.
//
// There is deliberately NO availability layer here. An earlier version had
// recurring weekly windows and blackout dates, copied from how Calendly works
// — but Calendly declares availability so that STRANGERS can book against your
// calendar unsupervised. Asywa is the only person booking these, so windows
// only ever constrained her, had to be maintained by her, and blocked the
// obvious case: a customer asks for Tuesday 6pm and she cannot enter it
// without first editing a rule. Removed on purpose; don't reintroduce it
// unless customers start booking their own slots.
//
// TIMEZONE: `scheduledFor` is a real instant. Everything that converts to and
// from Malaysia wall-clock does so against a fixed UTC+8, NOT the server's own
// clock — this box is set to Asia/Shanghai, the same offset as Malaysia only by
// coincidence, and depending on that would shift the whole diary the day the
// box is rebuilt elsewhere. Malaysia has no daylight saving.

enum DeliveryStatus {
  SCHEDULED
  COMPLETED
  // Called off before it happened — the slot is freed for someone else.
  CANCELLED
  // Went out but could not be delivered (nobody home, wrong address).
  // Distinct from CANCELLED because the run still cost time and fuel.
  FAILED
}

model DeliveryBooking {
  id              String         @id @default(cuid())
  // One delivery per order. Rescheduling moves this row rather than adding a
  // second, so an order can never be out for delivery twice.
  orderId         String         @unique
  // The slot's start instant, stored UTC. Always derived from a window's local
  // wall-clock time via the fixed Malaysia offset.
  scheduledFor    DateTime
  durationMinutes Int            @default(60)
  status          DeliveryStatus @default(SCHEDULED)
  // Free text for the driver: gate code, "call on arrival", landmark.
  notes           String?
  // Set when the run actually finished, so "booked for 2pm" and "delivered at
  // 3:40pm" stay separately answerable.
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([scheduledFor])
  @@index([status])
  @@map("delivery_bookings")
}

// ---------------------------------------------------------------------------
// Marketing email — list, campaigns, per-recipient delivery
// ---------------------------------------------------------------------------

// A marketing-email address. Deliberately NOT folded into Member: a Member is
// a login (password, verification, ban state) that exists to comment on
// Insights, whereas most of this list will be people who bought once and
// never made an account, or who only ever typed an address into the footer.
// The two populations barely overlap and their lifecycles share nothing.
model Subscriber {
  id     String           @id @default(cuid())
  // Stored lowercased at the controller, same normalisation as Member.email —
  // otherwise "A@x.com" and "a@x.com" become two rows that both get mailed.
  email  String           @unique
  status SubscriberStatus @default(SUBSCRIBED)
  source SubscriberSource

  // Single opt-in, no confirmation step: the two capture points are a footer
  // form and a checkout tickbox, and the checkout one is already an
  // established customer relationship. The deliverability protection that
  // matters here is instead (a) one-click unsubscribe on every send, (b) the
  // Resend bounce/complaint webhook flipping rows to UNSUBSCRIBED, and (c)
  // never mailing a row that isn't SUBSCRIBED.
  //
  // The token is stored raw, unlike Member.verifyTokenHash. That asymmetry is
  // deliberate: a leaked verify token lets an attacker take over a pending
  // address, while a leaked unsubscribe token only lets them remove someone
  // from a mailing list — the failure is in the direction the recipient can
  // already choose. It has to survive in plaintext to be embeddable in the
  // List-Unsubscribe header of every future send.
  unsubscribeToken  String    @unique
  unsubscribedAt    DateTime?
  // Why the row left the list, when it wasn't the person clicking: "bounced"
  // or "complained" from the Resend webhook. Null for a self-unsubscribe.
  unsubscribeReason String?

  // The welcome email is queued by these three columns rather than by a row in
  // EmailOutbox, whose orderId is a required FK — a signup has no order. A
  // nullable "welcome not sent yet" marker on the subscriber itself is a queue
  // with no extra table, is naturally exactly-once (the sweep only ever selects
  // welcomeSentAt = null), and survives a restart mid-send. It also degrades
  // the right way when marketing mail is switched off at signup time: the row
  // simply waits, and a welcome that arrives late is still a welcome — unlike
  // an order confirmation, which is why enqueueEmail() deliberately drops
  // those instead of queuing them.
  welcomeSentAt   DateTime?
  welcomeAttempts Int       @default(0)
  welcomeError    String?
  // Resend's id for the successful send, and where that message's lifecycle
  // landed — same enum and same webhook (modules/webhooks/resend-webhook.controller.ts)
  // as EmailOutbox, so a welcome email gets the exact DELIVERED/BOUNCED/COMPLAINED
  // tracking order emails already have. welcomeStatusAt is the last time the
  // webhook moved this row past SENT — the "delivered at" / "bounced at" instant.
  welcomeResendId String?
  welcomeStatus   EmailStatus @default(PENDING)
  welcomeStatusAt DateTime?
  // The first-order code minted for this specific person, single-use. Per
  // subscriber rather than one shared WELCOME10 because a shared code in this
  // niche ends up on a deals forum within a week and then discounts every
  // order the site takes. Nullable: welcome discounts can be switched off
  // entirely (welcome_discount_percent = 0), and rows created before the
  // welcome is sent have not been issued one yet.
  welcomeDiscountCodeId String?       @unique
  welcomeDiscountCode   DiscountCode? @relation(fields: [welcomeDiscountCodeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignRecipients CampaignRecipient[]

  @@index([status])
  // Drives the welcome sweep's only query.
  @@index([welcomeSentAt])
  // Drives the webhook's status update lookup, same as EmailOutbox.resendId.
  @@index([welcomeResendId])
  @@map("subscribers")
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

// Where the address came from. Worth keeping as an enum rather than free text
// because it is the only way to tell whether the footer form is earning its
// place, and campaign audiences may eventually want to segment on it.
enum SubscriberSource {
  FOOTER
  CHECKOUT
  ADMIN
}

// One marketing send. Content is a plain-text body plus an optional single
// CTA — the same constraint Insight.content lives under (no markdown library
// in this project), and for an email it is the right constraint anyway:
// bulletproof table-based HTML is generated from it by emails/campaign.ts,
// so an admin can never paste markup that breaks in Outlook.
model Campaign {
  id        String  @id @default(cuid())
  // Internal label for the list screen. Not shown to recipients.
  name      String
  subject   String
  // The line the inbox shows next to the subject. Optional; falls back to the
  // opening of the body.
  preheader String?
  body      String
  ctaLabel  String?
  ctaUrl    String?

  audience CampaignAudience @default(ALL)
  status   CampaignStatus   @default(DRAFT)

  // Frozen at send time, not computed on read: the audience keeps moving
  // (people subscribe, people leave), so a live count would silently rewrite
  // the history of what a past campaign actually went to.
  recipientCount Int       @default(0)
  sentAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients CampaignRecipient[]

  @@index([status])
  @@map("campaigns")
}

enum CampaignAudience {
  ALL
  // Subscribers whose address is on at least one PAID order.
  BUYERS
  // Subscribers with no paid order — the "you signed up but never bought" cut.
  NON_BUYERS
}

enum CampaignStatus {
  DRAFT
  // Recipient rows exist and the worker is draining them. A campaign is only
  // ever moved into this state once; there is no re-send, because the
  // (campaignId, subscriberId) unique key is what guarantees nobody gets the
  // same campaign twice.
  SENDING
  SENT
}

// One row per (campaign, subscriber), mirroring EmailOutbox's retry/backoff
// shape rather than reusing that table — EmailOutbox.orderId is a required FK
// and a campaign has no order. Materialising the audience into rows at send
// time (instead of iterating subscribers live) is what makes the send
// resumable across a restart and exactly-once per person.
model CampaignRecipient {
  id           String @id @default(cuid())
  campaignId   String
  subscriberId String
  // Snapshotted so a later email change (or a deleted subscriber) can't make
  // the delivery record lie about where the message actually went.
  toEmail      String

  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  resendId      String?
  sentAt        DateTime?

  createdAt DateTime @default(now())

  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([status, nextAttemptAt])
  @@index([resendId])
  @@map("campaign_recipients")
}
