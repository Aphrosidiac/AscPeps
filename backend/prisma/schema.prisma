generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  slug         String    @unique
  categoryId   String
  size         String?
  price        Int
  // Genuine time-limited sale — null salePrice means "not on sale". A sale is
  // only considered active when salePrice is set AND the current time falls
  // within [saleStartsAt, saleEndsAt]. See backend/src/utils/product-pricing.ts
  // (and its frontend counterpart) for the single source of truth on this
  // logic — order creation, storefront display, and JSON-LD must all agree.
  salePrice    Int?
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  description  String?
  benefits     String?
  dosageInfo   String?
  stock        Int       @default(0)
  imageUrl     String?
  coaUrl       String?
  featured     Boolean   @default(false)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  WHATSAPP
  BILLPLZ
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  phone           String
  email           String?
  address         String
  city            String
  state           String
  postcode        String
  subtotal        Int           @default(0)
  shippingFee     Int           @default(0)
  discountAmount  Int           @default(0)
  total           Int
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentGateway  String?
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentRef      String?
  discountCodeId  String?
  notes           String?
  trackingNumber  String?
  idempotencyKey  String?       @unique
  stockRestored   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items        OrderItem[]
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id])

  @@index([phone])
  @@index([status])
  @@index([orderNumber])
  @@index([paymentRef])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   DiscountType
  discountValue  Int
  minOrderAmount Int?
  maxUses        Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders Order[]

  @@map("discount_codes")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}
