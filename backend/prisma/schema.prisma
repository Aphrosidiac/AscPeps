generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  slug         String    @unique
  categoryId   String
  size         String?
  price        Int
  // Genuine time-limited sale — null salePrice means "not on sale". A sale is
  // only considered active when salePrice is set AND the current time falls
  // within [saleStartsAt, saleEndsAt]. See backend/src/utils/product-pricing.ts
  // (and its frontend counterpart) for the single source of truth on this
  // logic — order creation, storefront display, and JSON-LD must all agree.
  salePrice    Int?
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  description  String?
  benefits     String?
  dosageInfo   String?
  stock        Int       @default(0)
  imageUrl     String?
  coaUrl       String?
  featured     Boolean   @default(false)
  // Manual curation order among featured products (lower = shown first).
  // Ties (the common case — everything starts at 0) fall back to
  // createdAt desc, so this is inert until an admin actually reorders.
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Plain-text nudge shown near Add to Cart on the storefront (e.g. "This
  // peptide needs Bacteriostatic Water to reconstitute") — informational
  // only, distinct from the required/forced ProductAddOn mechanism below.
  addOnReminder String?

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  // Add-ons this product offers on its own page (e.g. BAC Water for a
  // lyophilized peptide) — directional, not reciprocal. See ProductAddOn.
  addOns            ProductAddOn[] @relation("ProductAddOns")
  offeredAsAddOnFor ProductAddOn[] @relation("AddOnOfProduct")

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

// Explicit join model for a directional Product-to-Product add-on relation
// (Prisma requires this for self-relations). productId = the product whose
// page shows the add-on; addOnId = the product being offered.
model ProductAddOn {
  id        String @id @default(cuid())
  productId String
  addOnId   String
  // Force-selected and locked on the storefront product page — the customer
  // cannot uncheck it. Enforced again server-side at order-creation time
  // (see createOrder) so a bypassed/omitted client request still can't ship
  // a reconstitution-requiring peptide without its required supplies.
  required  Boolean @default(false)
  // Fixed quantity added when this add-on is included — intentionally does
  // NOT scale with the parent product's purchased quantity.
  quantity  Int     @default(1)

  product Product @relation("ProductAddOns", fields: [productId], references: [id], onDelete: Cascade)
  addOn   Product @relation("AddOnOfProduct", fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([productId, addOnId])
  @@map("product_add_ons")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  WHATSAPP
  BILLPLZ
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  phone           String
  email           String?
  address         String
  city            String
  state           String
  postcode        String
  subtotal        Int           @default(0)
  shippingFee     Int           @default(0)
  discountAmount  Int           @default(0)
  total           Int
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentGateway  String?
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentRef      String?
  discountCodeId  String?
  notes           String?
  trackingNumber  String?
  idempotencyKey  String?       @unique
  stockRestored   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items        OrderItem[]
  discountCode DiscountCode? @relation(fields: [discountCodeId], references: [id])

  @@index([phone])
  @@index([status])
  @@index([orderNumber])
  @@index([paymentRef])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   DiscountType
  discountValue  Int
  minOrderAmount Int?
  maxUses        Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders Order[]

  @@map("discount_codes")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}
