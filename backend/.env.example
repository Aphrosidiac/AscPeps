DATABASE_URL="postgresql://postgres:password@localhost:5432/ascend"
# Generate with: openssl rand -hex 32   (min 32 chars, required)
JWT_SECRET="CHANGE_ME_run_openssl_rand_hex_32"
# Required when seeding in production (min 12 chars)
ADMIN_INITIAL_PASSWORD=""
PORT=3105
HOST="0.0.0.0"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="https://ascendpeptides.my"
WHATSAPP_NUMBER="601161092723"
BILLPLZ_API_KEY=""
BILLPLZ_COLLECTION_ID=""
BILLPLZ_SIGNATURE_KEY=""
BILLPLZ_SANDBOX=true
TOYYIBPAY_SECRET_KEY=""
TOYYIBPAY_CATEGORY_CODE=""
TOYYIBPAY_SANDBOX=true
# Self-hosted BTCPay Server. All three required for the gateway to be selectable.
BTCPAY_URL=""
BTCPAY_API_KEY=""
BTCPAY_STORE_ID=""
# Store settings -> Webhooks -> Add webhook -> https://ascendpeptides.my/api/v1/webhooks/btcpay
# -> select "An invoice has been settled", "An invoice has expired", "An invoice became invalid" -> copy the signing secret here.
BTCPAY_WEBHOOK_SECRET=""
# Transactional email (Resend). RESEND_API_KEY only makes sending possible —
# the actual on/off switch is the "emails_enabled" setting (Settings table),
# toggleable from the admin Emails page, not an env var. Defaults to off.
RESEND_API_KEY=""
EMAIL_FROM="Ascend Peptides <orders@ascendpeptides.my>"
# Resend dashboard -> Webhooks -> Add Endpoint -> https://ascendpeptides.my/api/v1/webhooks/resend -> select events email.delivered, email.bounced, email.complained -> copy the signing secret here.
RESEND_WEBHOOK_SECRET=""

# --- PostHog server-side analytics ---
# Emits the `purchase` event when a payment is actually confirmed. Use the SAME
# project token as the frontend (write-only) and the SAME region host — a
# mismatch silently drops every event. Both the key and POSTHOG_ENABLED=true
# are required; either missing means no server-side capture at all.
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_ENABLED=false

# Optional, LOCAL DEV ONLY. Origin the email templates load images from.
# Unset in production so mail points at the live site. Point it at the frontend
# dev server to preview emails against local, not-yet-deployed assets.
# EMAIL_ASSET_BASE_URL="http://localhost:3099"

# ─── WhatsApp AI agent ───
WHATSAPP_AGENT_ENABLED=false
WORKER_HTTP_TOKEN=
WORKER_HTTP_PORT=3106
REDIS_URL=redis://127.0.0.1:6379

# Read-side honesty guard (see docs/whatsapp-agent.md#grounding).
#   shadow  — log violations, deliver the reply unchanged. THE DEFAULT.
#   enforce — send the draft back to the model to be re-answered from tools,
#             and refuse rather than deliver an unsupported answer.
#   off     — disable entirely.
# Anything unrecognised means `shadow`, never `off`.
AGENT_GROUNDING_MODE=shadow

# ─── Downtime alerting ───
# A dropped WhatsApp socket is invisible: PM2 stays green, the site stays up.
# The API sink needs nothing configured — it emails every AdminUser using the
# Resend key already set above. These two are optional extras on top.
ALERT_DOWN_AFTER_MINUTES=10
ALERT_EMAIL_TO=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
